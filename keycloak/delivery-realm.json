{
  "realm": "delivery",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Platform administrator"
      },
      {
        "name": "CUSTOMER",
        "description": "End customer"
      },
      {
        "name": "VENDOR_ADMIN",
        "description": "Vendor account admin"
      },
      {
        "name": "VENDOR_STAFF",
        "description": "Vendor staff member"
      },
      {
        "name": "COURIER",
        "description": "Delivery courier"
      },
      {
        "name": "FINANCE",
        "description": "Finance team"
      },
      {
        "name": "OPS",
        "description": "Operations team"
      },
      {
        "name": "SUPPORT",
        "description": "Support team"
      },
      {
        "name": "provisioning:write",
        "description": "M2M tenant provisioning"
      }
    ]
  },
  "clients": [
    {
      "clientId": "delivery-app",
      "name": "Delivery App",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "delivery-admin-service",
      "name": "Delivery Admin Service",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET:delivery-admin-secret}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "subscriptions-provisioner",
      "name": "Subscriptions Provisioner",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_PROVISIONER_CLIENT_SECRET:provisioner-secret}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "pede-aqui-web",
      "name": "Pede Aqui Delivery Web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "pede-aqui-mobile",
      "name": "Pede Aqui Customer Mobile",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "com.pedeaqui.delivery:/oauthredirect"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "pede-aqui-courier-mobile",
      "name": "Pede Aqui Courier Mobile",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "com.pedeaqui.courier:/oauthredirect"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@pede-aqui.com",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "finance",
      "email": "finance@pede-aqui.com",
      "firstName": "Finance",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "finance123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "FINANCE"
      ]
    },
    {
      "username": "support",
      "email": "support@pede-aqui.com",
      "firstName": "Support",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "support123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SUPPORT"
      ]
    },
    {
      "username": "ops",
      "email": "ops@pede-aqui.com",
      "firstName": "Operations",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "ops123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OPS"
      ]
    },
    {
      "username": "service-account-delivery-admin-service",
      "email": "service-account-delivery-admin-service@localhost",
      "enabled": true,
      "serviceAccountClientId": "delivery-admin-service",
      "clientRoles": {
        "realm-management": [
          "realm-admin",
          "manage-users",
          "create-client",
          "manage-clients",
          "view-clients",
          "view-users",
          "query-clients",
          "query-users"
        ]
      }
    },
    {
      "username": "service-account-subscriptions-provisioner",
      "email": "service-account-subscriptions-provisioner@localhost",
      "enabled": true,
      "serviceAccountClientId": "subscriptions-provisioner",
      "realmRoles": [
        "provisioning:write"
      ]
