{
  "realm": "delivery",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "passwordPolicy": "length(10) and digits(1) and upperCase(1) and lowerCase(1) and notUsername and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "otpPolicyCodeReusable": false,
  "browserFlow": "browser-privileged-mfa",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Platform administrator"
      },
      {
        "name": "CUSTOMER",
        "description": "End customer"
      },
      {
        "name": "VENDOR_ADMIN",
        "description": "Vendor account admin"
      },
      {
        "name": "VENDOR_STAFF",
        "description": "Vendor staff member"
      },
      {
        "name": "COURIER",
        "description": "Delivery courier"
      },
      {
        "name": "FINANCE",
        "description": "Finance team"
      },
      {
        "name": "OPS",
        "description": "Operations team"
      },
      {
        "name": "SUPPORT",
        "description": "Support team"
      },
      {
        "name": "provisioning:write",
        "description": "M2M tenant provisioning"
      }
    ]
  },
