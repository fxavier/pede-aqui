<mxfile host="drawio" version="26.0.0"><diagram id="p0" name="Encomenda (OrderStatus)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Máquina de estados — Encomenda (OrderStatus) + estado financeiro do Payment" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="o_init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="280.0" y="60" width="20" height="20" as="geometry"/></mxCell><mxCell id="o_active" value="Encomenda ativa (≠ CANCELLED, ≠ REFUNDED)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;absoluteArcSize=1;container=1;collapsible=0;pointerEvents=0;fillColor=none;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=3;fontSize=11;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="640" height="860" as="geometry"/></mxCell><mxCell id="o_pre" value="Pré-dispatch — canceláveis pela venda" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;absoluteArcSize=1;container=1;collapsible=0;pointerEvents=0;fillColor=none;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=3;fontSize=11;strokeColor=#82b366;dashed=1;" vertex="1" parent="o_active"><mxGeometry x="30" y="40" width="580" height="470" as="geometry"/></mxCell><mxCell id="o_pp" value="PAYMENT_PENDING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="o_pre"><mxGeometry x="70" y="50" width="260" height="46" as="geometry"/></mxCell><mxCell id="o_pc" value="PAYMENT_CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="o_pre"><mxGeometry x="70" y="160" width="260" height="46" as="geometry"/></mxCell><mxCell id="o_ac" value="ACCEPTED_BY_VENDOR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="o_pre"><mxGeometry x="70" y="270" width="260" height="46" as="geometry"/></mxCell><mxCell id="o_pr" value="PREPARING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="o_pre"><mxGeometry x="70" y="380" width="260" height="46" as="geometry"/></mxCell><mxCell id="o_rp" value="READY_FOR_PICKUP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="o_active"><mxGeometry x="100" y="560" width="260" height="46" as="geometry"/></mxCell><mxCell id="o_as" value="ASSIGNED_TO_COURIER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="o_active"><mxGeometry x="100" y="670" width="260" height="46" as="geometry"/></mxCell><mxCell id="o_dl" value="DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="o_active"><mxGeometry x="100" y="780" width="260" height="46" as="geometry"/></mxCell><mxCell id="o_cn" value="CANCELLED&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;cancellation_reason = SELLER_REJECTED (rejeição)&lt;br&gt;ou null (cancel de venda, override, entrega falhada)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="320" height="220" as="geometry"/></mxCell><mxCell id="o_rf" value="REFUNDED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="900" width="240" height="60" as="geometry"/></mxCell><mxCell id="o_f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1270" y="348" width="24" height="24" as="geometry"/></mxCell><mxCell id="o_f2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1370" y="918" width="24" height="24" as="geometry"/></mxCell><mxCell id="e4" value="POST /api/v1/checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_init" target="o_pp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="POST /api/v1/payments/{id}/confirm&lt;br&gt;[mock ativo; payment PENDING_CONFIRMATION] / payment CONFIRMED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_pp" target="o_pc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="PATCH /api/v1/vendor/orders/{id}/accept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_pc" target="o_ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="PATCH …/preparing&lt;br&gt;(ou status-override OPS/ADMIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_ac" target="o_pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="PATCH …/ready-for-pickup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_pr" target="o_rp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="POST /api/v1/dispatch-jobs/assign (OPS/ADMIN)&lt;br&gt;/ DispatchJob ASSIGNED, Delivery ASSIGNED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_rp" target="o_as"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="POST /api/v1/deliveries/{id}/complete [PIN válido]&lt;br&gt;/ PIN limpo; stock COMMITTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_as" target="o_dl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="POST /api/v1/sales/orders/{id}/cancel&lt;br&gt;[PENDING | PAYMENT_PENDING … PREPARING]&lt;br&gt;/ retireBeforePickup + release stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.06;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_pre" target="o_cn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="PATCH /vendor/orders/{id}/reject → SELLER_REJECTED&lt;br&gt;/ refund do restante REQUESTED; ou status-override" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.32;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_pc" target="o_cn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="PATCH …/reject → SELLER_REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_ac" target="o_cn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="PATCH /api/v1/deliveries/{id}/status FAILED_DELIVERY&lt;br&gt;/ release stock (no-op após recolha)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_as" target="o_cn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="793"/></Array></mxGeometry></mxCell><mxCell id="e15" value="approveRefund&lt;br&gt;[Σ refunds aprovados ≥ amount; order ≠ CANCELLED]&lt;br&gt;/ PIN limpo; retire + release se antes da recolha" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.977;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_active" target="o_rf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_cn" target="o_f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_rf" target="o_f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Estados legados&lt;/b&gt; (no enum, nunca escritos pelo código atual):&lt;br&gt;PENDING · REJECTED_BY_VENDOR (rejeição antiga; hoje CANCELLED+SELLER_REJECTED) · DISPATCH_PENDING · PICKED_UP · DELIVERING · REFUND_PENDING.&lt;br&gt;O status-override (allow-list) ainda aceita DISPATCH_PENDING → ASSIGNED_TO_COURIER e DELIVERING → DELIVERED.&lt;br&gt;CANCELLED, REFUNDED e REJECTED_BY_VENDOR são terminais e não entregáveis (409 order_not_deliverable)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1340" y="230" width="420" height="190" as="geometry"/></mxCell><mxCell id="c19" value="Checkout cria também Payment PENDING_CONFIRMATION, Delivery DISPATCH_PENDING e reserva stock (RESERVED).&lt;br&gt;Uma rejeição repetida (order já CANCELLED/REJECTED_BY_VENDOR) devolve o estado atual sem efeitos.&lt;br&gt;Um reembolso total de uma order CANCELLED deixa-a CANCELLED: o estado financeiro vive no Payment." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1340" y="440" width="420" height="110" as="geometry"/></mxCell><mxCell id="p_reg" value="Payment — estado financeiro (criado no checkout; independente do OrderStatus)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;absoluteArcSize=1;container=1;collapsible=0;pointerEvents=0;fillColor=none;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=3;fontSize=11;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1300" height="210" as="geometry"/></mxCell><mxCell id="p_init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="p_reg"><mxGeometry x="30" y="83" width="20" height="20" as="geometry"/></mxCell><mxCell id="p_pc" value="PENDING_CONFIRMATION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="p_reg"><mxGeometry x="90" y="70" width="220" height="46" as="geometry"/></mxCell><mxCell id="p_cf" value="CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="p_reg"><mxGeometry x="420" y="70" width="180" height="46" as="geometry"/></mxCell><mxCell id="p_pr" value="PARTIALLY_REFUNDED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="p_reg"><mxGeometry x="730" y="70" width="220" height="46" as="geometry"/></mxCell><mxCell id="p_fr" value="FULLY_REFUNDED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="p_reg"><mxGeometry x="1050" y="70" width="200" height="46" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_init" target="p_pc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="confirm()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_pc" target="p_cf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="approveRefund&lt;br&gt;[Σ aprovados &amp;lt; amount]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_cf" target="p_pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="approveRefund&lt;br&gt;[Σ aprovados ≥ amount]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_pr" target="p_fr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="approveRefund [Σ aprovados ≥ amount]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_cf" target="p_fr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="1180"/><mxPoint x="1210" y="1180"/></Array></mxGeometry></mxCell><mxCell id="e25" value="nova aprovação parcial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_pr" target="p_pr"><mxGeometr