 não envia estados intermédios)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_ac" target="d_dl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="443"/><mxPoint x="100" y="1133"/></Array></mxGeometry></mxCell><mxCell id="e16" value="retireBeforePickup()&lt;br&gt;[reembolso total | cancel de venda |&lt;br&gt;override → CANCELLED | rejeição do vendedor]&lt;br&gt;/ DispatchJob ativo → CANCELLED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.0926;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_before" target="d_cn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_cn" target="d_f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_dl" target="d_f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_fl" target="d_f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Regras (DeliveryService)&lt;/b&gt;&lt;br&gt;• PATCH /deliveries/{id}/status: só o estafeta atribuído (DeliveryAccessGuard) ou OPS/ADMIN (auditado); transição fora da matriz → 409 invalid_delivery_transition.&lt;br&gt;• DELIVERED só via /complete (PIN HMAC; errado → 400 invalid_delivery_code; bloqueado → 423 delivery_code_locked).&lt;br&gt;• Order REFUNDED | CANCELLED | REJECTED_BY_VENDOR → 409 order_not_deliverable antes de qualquer mutação.&lt;br&gt;• Depois da recolha nada é retirado: a mercadoria saiu (ops resolvem).&lt;br&gt;• REJECTED existe no enum mas nunca é escrito (rejeitar a oferta marca REASSIGNED).&lt;br&gt;• V035: no máximo 1 delivery ativa por estafeta (ASSIGNED … ARRIVED_AT_CUSTOMER)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="500" height="200" as="geometry"/></mxCell><mxCell id="j_reg" value="DispatchJob (DispatchJobStatus)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;absoluteArcSize=1;container=1;collapsible=0;pointerEvents=0;fillColor=none;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=3;fontSize=11;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1000" y="520" width="500" height="330" as="geometry"/></mxCell><mxCell id="j_init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="j_reg"><mxGeometry x="20" y="53" width="20" height="20" as="geometry"/></mxCell><mxCell id="j_as" value="ASSIGNED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="j_reg"><mxGeometry x="80" y="40" width="150" height="46" as="geometry"/></mxCell><mxCell id="j_ac" value="ACCEPTED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="j_reg"><mxGeometry x="280" y="40" width="150" height="46" as="geometry"/></mxCell><mxCell id="j_ra" value="REASSIGNABLE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="j_reg"><mxGeometry x="80" y="170" width="150" height="46" as="geometry"/></mxCell><mxCell id="j_cn" value="CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="j_reg"><mxGeometry x="280" y="240" width="150" height="46" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_init" target="j_as"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="accept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_as" target="j_ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_as" target="j_ra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="reassign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_ra" target="j_as"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="retire&lt;br&gt;(ativo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_ac" target="j_cn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="retire" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_ra" target="j_cn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1155" y="783"/></Array></mxGeometry></mxCell><mxCell id="c27" value="COMPLETED existe no enum mas nunca é escrito: o job fica ACCEPTED após a entrega." style="text;html=1;fontSize=10;fontColor=#666666;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1020" y="805" width="250" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
