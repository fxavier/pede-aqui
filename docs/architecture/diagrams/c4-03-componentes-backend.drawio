<mxCell id="a2" value="&lt;b style='font-size:11px'&gt;TenantRequestFilter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#555555'&gt;[common.security · ordem LOWEST−10]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;&lt;b&gt;TenantContext&lt;/b&gt;: azp→tenant (cliente) · claim tenant_id · X-Tenant-Id só platform admin (auditado) · provisiona perfil de cliente&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="660" y="132" width="240" height="120" as="geometry"/></mxCell>
