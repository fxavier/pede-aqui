<mxCell id="a0" value="&lt;b style='font-size:11px'&gt;CorrelationIdFilter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#555555'&gt;[common.config · @Order(HIGHEST_PRECEDENCE)]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;X-Correlation-Id → atributo, MDC e header de resposta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="132" width="240" height="120" as="geometry"/></mxCell>
