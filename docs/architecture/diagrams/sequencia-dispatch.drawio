nt x="396.0" y="1122" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="POST /api/v1/dispatch-jobs/{jobId}/reassign?operatingZoneId&lt;br&gt;(ou POST /api/v1/ops/dispatch/jobs/{jobId}/reassign)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116.0" y="1168" as="sourcePoint"/><mxPoint x="384.0" y="1168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e34" value="reassign(jobId, zoneId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="396.0" y="1200" as="sourcePoint"/><mxPoint x="664.0" y="1200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e35" value="job ≠ REASSIGNABLE → 409 job_not_reassignable; firstFreeCourier excluindo o anterior;&lt;br&gt;job → ASSIGNED (novo expires_at); delivery → ASSIGNED; flush V035; audit DISPATCH_REASSIGN" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676.0" y="1246" as="sourcePoint"/><mxPoint x="1224.0" y="1246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e36" value="200 OK — nova oferta" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#808080;fontColor=#4d4d4d;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="384.0" y="1278" as="sourcePoint"/><mxPoint x="116.0" y="1278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=50;height=22;fillColor=none;strokeColor=#9673a6;fontStyle=1;fontSize=11;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="1074" width="1680" height="218" as="geometry"/></mxCell><mxCell id="c38" value="[Estafeta rejeita a oferta]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#5a3d6e;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="68" y="1076" width="520" height="18" as="geometry"/></mxCell><mxCell id="c39" value="V035 (índices únicos parciais): &lt;b&gt;uq_dispatch_jobs_active_delivery&lt;/b&gt; (delivery_id) WHERE status IN (ASSIGNED, ACCEPTED, REASSIGNABLE);&lt;br&gt;&lt;b&gt;uq_deliveries_active_courier&lt;/b&gt; (courier_id) WHERE status IN (ASSIGNED … ARRIVED_AT_CUSTOMER). A expiração só bloqueia o aceite: não há nova oferta automática." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510.0" y="1302" width="860" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
