er (senão 404); job ativo (ASSIGNED | ACCEPTED | REASSIGNABLE)?&lt;br&gt;→ 409 &lt;b&gt;dispatch_job_already_active&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676.0" y="290" as="sourcePoint"/><mxPoint x="1224.0" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="eligibleInZone(operatingZoneId) — APPROVED + online" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676.0" y="322" as="sourcePoint"/><mxPoint x="944.0" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="candidatos" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#808080;fontColor=#4d4d4d;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="944.0" y="354" as="sourcePoint"/><mxPoint x="676.0" y="354" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e9" value="existsByTenantIdAndCourierIdAndStatusIn(COURIER_BUSY:&lt;br&gt;ASSIGNED … ARRIVED_AT_CUSTOMER) — exclui estafetas ocupados" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676.0" y="426" as="sourcePoint"/><mxPoint x="1224.0" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676.0" y="456" as="sourcePoint"/><mxPoint x="676.0" y="478" as="targetPoint"/><Array as="points"><mxPoint x="706.0" y="456"/><mxPoint x="706.0" y="478"/></Array></mxGeometry></mxCell><mxCell id="c